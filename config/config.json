{
  "process_name": "cs2",
  "game_module": "libclient.so",
  "socket_path": "@.cs_pipe_stream",
  "hotkey": "F8",
  "fps_limit": 144,
  "team_check": true,
  "max_distance": 0,

  "stealth": {
    "spoof_process_name": "pipewire-sys",
    "randomize_window_class": false
  },

  "colors": {
    "local": "#00FF00FF",
    "enemy": "#FF4040FF",
    "teammate": "#40A0FFFF"
  },

  "esp": {
    "box_height_units": 70,
    "box_width_ratio": 0.45,
    "health_bar_width": 6,
    "show_names": true,
    "show_distance": true,
    "show_status_text": true,
    "show_skeleton": true,
    "font": "DejaVu Sans:size=10",
    "monitor": -1
  },

  "aimbot": {
    "enabled": true,
    "hotkey": "MOUSE5",
    "bone": "head",
    "fov": 119,
    "smooth": 2,
    "team_check": true,
    "visible_check": false,
    "humanize": true
  },

  "triggerbot": {
    "enabled": true,
    "hotkey": "alt",
    "pre_delay_ms": 190,
    "post_delay_ms": 55,
    "cooldown_ms": 350,
    "humanize": true
  }
}
